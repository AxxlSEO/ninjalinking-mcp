{
  "name": "ninjalinking-mcp",
  "version": "2.1.0",
  "description": "Local MCP server for secure NinjaLinking backlink order management",
  "main": "dist/index.js",
  "bin": {
    "ninjalinking-mcp": "dist/index.js"
  },
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "watch": "tsc --watch",
    "test": "npm run build && node --test tests/api-client.test.mjs tests/server.test.mjs",
    "test:coverage": "npm run build && node --test --experimental-test-coverage tests/api-client.test.mjs tests/server.test.mjs",
    "smoke:pack": "node tests/package-smoke.mjs",
    "prepack": "npm run build"
  },
  "keywords": ["mcp", "ninjalinking", "backlinks", "seo", "orders", "ai", "claude", "model-context-protocol"],
  "author": "NinjaLinking <axelguyennot@ninjalinking.fr>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AxxlSEO/ninjalinking-mcp"
  },
  "homepage": "https://app.ninjalinking.fr/mcp-access",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
